# Copy this file to configs/.env and customize before running docker compose.
# These variables configure docker/docker-compose.cloud-access-core.yml
# and provide overrides for the Go service via environment variables.

POSTGRES_USER=cloudaccess
POSTGRES_PASSWORD=cloudaccess
POSTGRES_DB=cloud_access

# Override host ports when existing services already bind 5432/6379
CLOUD_ACCESS_HOST_POSTGRES_PORT=5432
CLOUD_ACCESS_HOST_REDIS_PORT=6379
CLOUD_ACCESS_HOST_HTTP_PORT=8080
CLOUD_ACCESS_HOST_PROM_PORT=9090
CLOUD_ACCESS_HOST_GRPC_PORT=9091

# Go service overrides (match the container service hostnames)
CLOUD_ACCESS_DB_DSN=postgres://cloudaccess:cloudaccess@postgres:5432/cloud_access?sslmode=disable
CLOUD_ACCESS_REDIS_ADDR=redis:6379
CLOUD_ACCESS_ENV=development
CLOUD_ACCESS_LOG_LEVEL=info
CLOUD_ACCESS_PROM_ADDR=:9090

# Optional: fix signing keys so tokens survive restarts. Leave blank to auto-generate per boot.
CLOUD_ACCESS_AUTH_SIGNING_KEY_ID=dev-key
CLOUD_ACCESS_AUTH_SIGNING_PRIV=
CLOUD_ACCESS_AUTH_SIGNING_PUB=

# Device/config encryption keys. Provide 32-byte base64 strings.
CLOUD_ACCESS_DEVICE_PROFILE_KEY=
CLOUD_ACCESS_CONFIG_SIGNING_KEY=

# Gateway/admin defaults
CLOUD_ACCESS_GATEWAY_ADMIN_TOKEN=dev-admin-token
CLOUD_ACCESS_GATEWAY_ENABLED=true

# Telemetry buffer directory inside container (kept on named volume)
CLOUD_ACCESS_TELEM_BUFFER_PATH=/app/data/telemetry-buffer

# Optional: cloud QA endpoints for integration tests (Task 10)
# CLOUD_ACCESS_TEST_POSTGRES_DSN=postgres://heanyang:2580heanyang@38.165.21.136:5432/cloud_access_core?sslmode=disable
# CLOUD_ACCESS_TEST_REDIS_ADDR=38.165.21.136:6379
# CLOUD_ACCESS_TEST_REDIS_PASSWORD=heanyang

# -----------------------------------------------------------------------------
# realtime-interview-core environment
# -----------------------------------------------------------------------------

# Point the realtime-interview-core binary at the JSON config (defaults to this file
# when running via make rtc-run)
REALTIME_INTERVIEW_CONFIG=../../services/realtime-interview-core/configs/config.example.yaml

# Local development defaults (override to target cloud Postgres/Redis). The sample
# DSN below matches the user-provided cloud instance; the service will create the
# realtime_interview_core database + tables on startup if they do not already exist.
REALTIME_INTERVIEW_DB_DSN=postgres://heanyang:2580heanyang@38.165.21.136:5432/realtime_interview_core?sslmode=disable
REALTIME_INTERVIEW_REDIS_ADDR=38.165.21.136:6379
REALTIME_INTERVIEW_REDIS_PASSWORD=heanyang
REALTIME_INTERVIEW_ENV=development
REALTIME_INTERVIEW_LOG_LEVEL=info
REALTIME_INTERVIEW_PROM_ADDR=:9096

# Aliyun provider credentials (obtain via Aliyun console or token endpoint). Leave
# TOKEN blank to fall back to on-demand token fetch via token_url.
REALTIME_INTERVIEW_PROVIDER_ALIYUN_APP_KEY=changeme-app-key
REALTIME_INTERVIEW_PROVIDER_ALIYUN_TOKEN=
REALTIME_INTERVIEW_PROVIDER_ALIYUN_TOKEN_URL=https://nls-gateway.cn-shanghai.aliyuncs.com/stream/v1/token

# Usage exporter buffer path and orchestration prompt overrides
REALTIME_INTERVIEW_USAGE_BUFFER_PATH=../../services/realtime-interview-core/data/usage-buffer
REALTIME_INTERVIEW_SPEECH_BUFFER_PREFIX=realtime-interview-core:chunks

# LLM provider credentials (optional overrides per provider). Leave keys blank if
# you prefer to inject them via Docker secrets or runtime env.
REALTIME_INTERVIEW_ORCH_OPENAI_API_KEY=
REALTIME_INTERVIEW_ORCH_OPENAI_BASE_URL=https://api.gptgod.online/v1/chat/completions
REALTIME_INTERVIEW_ORCH_OPENAI_MODEL=gpt-5-thinking-all
REALTIME_INTERVIEW_ORCH_OPENAI_TIMEOUT=30

REALTIME_INTERVIEW_ORCH_DEEPSEEK_API_KEY=
REALTIME_INTERVIEW_ORCH_DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
REALTIME_INTERVIEW_ORCH_DEEPSEEK_MODEL=deepseek-reasoner
REALTIME_INTERVIEW_ORCH_DEEPSEEK_TIMEOUT=30

REALTIME_INTERVIEW_ORCH_GLM_API_KEY=
REALTIME_INTERVIEW_ORCH_GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
REALTIME_INTERVIEW_ORCH_GLM_MODEL=GLM-4.6
REALTIME_INTERVIEW_ORCH_GLM_TIMEOUT=30

# Optional: cloud QA endpoints for realtime-interview-core integration tests
# REALTIME_TEST_POSTGRES_DSN=postgres://heanyang:2580heanyang@38.165.21.136:5432/realtime_interview_core?sslmode=disable
# REALTIME_TEST_REDIS_ADDR=38.165.21.136:6379
# REALTIME_TEST_REDIS_PASSWORD=heanyang
