{
  "name": "desktop-guardian-client-electron",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm run build && cross-env NODE_ENV=development ELECTRON_START_URL=http://127.0.0.1:5173 electron ./dist/main.js",
    "package": "electron-builder --config ../electron-builder.yml"
  },
  "dependencies": {
    "@guardian/config": "workspace:*",
    "@guardian/config-store": "workspace:*",
    "@guardian/ipc": "workspace:*",
    "@guardian/network-client": "workspace:*",
    "electron": "^29.3.0",
    "electron-log": "^5.1.4",
    "electron-updater": "^6.1.8",
    "ws": "^8.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/electron": "^1.6.4",
    "@types/node": "^20.12.12",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "electron-builder": "^24.13.3",
    "eslint-config-prettier": "^9.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
